{
  "name": "@katorlys/oreui",
  "version": "0.0.0-alpha.1",
  "description": "An unofficial Ore UI cross-framework component library.",
  "type": "module",
  "license": "MPL-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./icons/*": "./dist/icons/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
