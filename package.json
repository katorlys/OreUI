{
  "name": "oreui-web",
  "version": "0.0.1-beta.1",
  "description": "An unofficial Ore UI cross-framework component library.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katorlys/OreUI.git"
  },
  "keywords": [
    "ore-ui",
    "oreui",
    "minecraft",
    "bedrock",
    "css",
    "component",
    "library",
    "component-library",
    "minecraft-ui",
    "style",
    "pixel",
    "ui",
    "ugc"
  ],
  "homepage": "https://katorly.dev/OreUI",
  "bugs": {
    "url": "https://github.com/katorlys/OreUI/issues"
  },
  "license": "MPL-2.0",
  "sideEffects": [
    "**/*.css",
    "dist/components/**/*.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*/*.d.ts",
      "import": "./dist/components/*/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./icons/*": "./dist/icons/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:core && pnpm --filter @oreui-web/react build && pnpm --filter @oreui-web/vue build && pnpm --filter @oreui-web/svelte build && pnpm --filter @oreui-web/solid build",
    "build:core": "vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "docs:build": "pnpm --filter @katorlys/oreui-docs build",
    "docs:dev": "pnpm --filter @katorlys/oreui-docs dev",
    "docs:typecheck": "pnpm --filter @katorlys/oreui-docs typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:solid-demo && pnpm --filter @oreui-web/react typecheck && pnpm --filter @oreui-web/vue typecheck && pnpm --filter @oreui-web/svelte typecheck && pnpm --filter @oreui-web/solid typecheck",
    "typecheck:core": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-js": "^1.9.15",
    "svelte": "^5.56.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
