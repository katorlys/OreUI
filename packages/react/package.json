{
  "name": "@katorlys/oreui-react",
  "version": "0.0.0-alpha.3",
  "description": "React wrapper for the unofficial Ore UI component library.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katorlys/OreUI.git",
    "directory": "packages/react"
  },
  "keywords": [
    "ore-ui",
    "oreui",
    "react",
    "minecraft",
    "component",
    "ui",
    "ugc"
  ],
  "homepage": "https://lab.katorly.com/OreUI",
  "bugs": {
    "url": "https://github.com/katorlys/OreUI/issues"
  },
  "license": "MPL-2.0",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@katorlys/oreui": "workspace:*",
    "@lit/react": "^1.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@katorlys/oreui": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
