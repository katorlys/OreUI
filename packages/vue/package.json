{
  "name": "@oreui-web/vue",
  "version": "0.0.0",
  "description": "Unofficial Ore UI component library for Vue applications.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katorlys/OreUI.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "ore-ui",
    "oreui",
    "minecraft",
    "bedrock",
    "css",
    "component",
    "library",
    "component-library",
    "minecraft-ui",
    "style",
    "pixel",
    "ui",
    "ugc",
    "vue",
    "vue3"
  ],
  "homepage": "https://katorly.dev/OreUI",
  "bugs": {
    "url": "https://github.com/katorlys/OreUI/issues"
  },
  "license": "MPL-2.0",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oreui-web": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
