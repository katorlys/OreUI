{
  "name": "@oreui-web/svelte",
  "version": "0.0.0",
  "description": "Unofficial Ore UI component library for Svelte applications.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katorlys/OreUI.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "ore-ui",
    "oreui",
    "minecraft",
    "bedrock",
    "css",
    "component",
    "library",
    "component-library",
    "minecraft-ui",
    "style",
    "pixel",
    "ui",
    "ugc",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://katorly.dev/OreUI",
  "bugs": {
    "url": "https://github.com/katorlys/OreUI/issues"
  },
  "license": "MPL-2.0",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "import": "./dist/components/*.svelte"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "dependencies": {
    "oreui-web": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
